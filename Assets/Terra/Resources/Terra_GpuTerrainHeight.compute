#pragma kernel GenerateHeights

RWStructuredBuffer<float> _TerraHeightBuffer;

int _TerraPointsPerLod;
int _TerraVerticesPerAxis;
int _TerraLodCount;
int _TerraSeed;
float _TerraMaxHeight;
float _TerraBaseFrequency;
float _TerraLacunarity;
float _TerraGain;
float4 _TerraLodOrigins[6];

float TerraHash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7)) + _TerraSeed * 0.013) * 43758.5453123);
}

float TerraValueNoise(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);

    float a = TerraHash21(i);
    float b = TerraHash21(i + float2(1.0, 0.0));
    float c = TerraHash21(i + float2(0.0, 1.0));
    float d = TerraHash21(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float TerraFbm(float2 p)
{
    float value = 0.0;
    float amplitude = 1.0;
    float normalizer = 0.0;
    float frequency = _TerraBaseFrequency;

    [unroll]
    for (int octave = 0; octave < 5; ++octave)
    {
        value += (TerraValueNoise(p * frequency) * 2.0 - 1.0) * amplitude;
        normalizer += amplitude;
        amplitude *= _TerraGain;
        frequency *= _TerraLacunarity;
    }

    return value / normalizer;
}

float TerraHeight(float2 worldXZ)
{
    float broad = TerraFbm(worldXZ);
    float ridges = 1.0 - abs(TerraFbm(worldXZ * 0.42 + float2(73.0, -41.0)));
    return (broad * 0.68 + (ridges - 0.5) * 0.64) * _TerraMaxHeight;
}

[numthreads(64, 1, 1)]
void GenerateHeights(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint index = dispatchThreadID.x;
    uint totalCount = (uint)(_TerraPointsPerLod * _TerraLodCount);
    if (index >= totalCount)
        return;

    uint lod = index / (uint)_TerraPointsPerLod;
    uint localIndex = index - lod * (uint)_TerraPointsPerLod;
    uint x = localIndex % (uint)_TerraVerticesPerAxis;
    uint z = localIndex / (uint)_TerraVerticesPerAxis;
    float4 lodData = _TerraLodOrigins[lod];
    float2 worldXZ = lodData.xy + (float2(x, z) - 64.0) * lodData.z;

    // Height samples live in a structured buffer so every visible vertex stays GPU generated.
    _TerraHeightBuffer[index] = TerraHeight(worldXZ);
}
