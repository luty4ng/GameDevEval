{
  "name": "game-eval-studio",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:client": "vite --mode server --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "tsx --env-file=.env.local server/index.ts",
    "build:server": "tsc --noEmit && vite build --mode server",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx server/manage.ts migrate",
    "admin:init": "tsx server/manage.ts admin",
    "test:server": "vitest run tests/server.test.ts",
    "password:reset": "tsx server/manage.ts reset-password",
    "schema:api": "tsx scripts/api-schema.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "better-auth": "1.7.7",
    "fastify": "5.12.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "4.23.15",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "16.14.0-beta.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
