              "timeBudget": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10080
              },
              "passThreshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "engine",
              "engineVersion",
              "platform",
              "difficulty",
              "timeBudget",
              "passThreshold"
            ],
            "additionalProperties": false
