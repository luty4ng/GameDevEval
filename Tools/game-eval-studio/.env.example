# Copy to .env (Compose) or .env.local (local API), then replace placeholders.
# Generate 3 independent secrets with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DB_ADMIN_PASSWORD=replace-with-independent-random-hex
DB_PASSWORD=replace-with-independent-random-hex
AUTH_SECRET=replace-with-independent-random-hex
APP_URL=https://gameeval.example.com
APP_HOST=gameeval.example.com
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=replace-with-existing-resolver-name
# Local API only (Compose constructs its own URL):
DATABASE_URL=postgres://gameeval:replace-with-url-safe-password@127.0.0.1:5432/gameeval
NODE_ENV=development
PORT=3000
